<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AMANetworkAnalyzer</AssemblyName>
    <RootNamespace>AMANetworkAnalyzer</RootNamespace>
    <Description>Azure Monitor Agent Network Trace Analyzer</Description>
  </PropertyGroup>

  <!-- Single-file publish settings (build-release.ps1 supplies the RID) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMANetworkAnalyzer.Core\AMANetworkAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
